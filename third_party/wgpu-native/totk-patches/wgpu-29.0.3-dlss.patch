         texture_transitions: Vec<wgt::TextureTransition<R::Texture>>,
     },
+    /// (TOTK port) Raw HAL commands in the middle of a wgpu encoder: the textures are transitioned to the given
+    /// states first (as `TransitionResources`), then `call` records on the open raw encoder. Whatever `call` records
+    /// must leave the textures in those states (e.g. DLSS, which "always transitions buffers back").
+    #[cfg_attr(feature = "serde", serde(skip))]
+    TotkRaw {
+        texture_transitions: Vec<wgt::TextureTransition<R::Texture>>,
+        call: TotkRawCall,
+    },
+}
+
+/// (TOTK port) The raw recording of a [`Command::TotkRaw`]: called once, with the open HAL encoder, when the
+/// command buffer is encoded (at `finish`).
+#[derive(Clone)]
+pub struct TotkRawCall(pub Arc<dyn Fn(&mut dyn hal::DynCommandEncoder) + Send + Sync>);
+impl core::fmt::Debug for TotkRawCall {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.write_str("TotkRawCall")
+    }
+}
+#[cfg(feature = "serde")]
+impl Default for TotkRawCall {
+    fn default() -> Self {
+        Self(Arc::new(|_| {}))
+    }
 }
 
